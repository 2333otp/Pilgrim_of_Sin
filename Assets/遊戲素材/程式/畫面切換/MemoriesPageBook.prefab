--- !u!114 &1148682473585917499
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1618199197476001625}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25cc485e50b1e1f4f8194c10ccadc67d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PilgrimOfSin.MemoryPageBook
  _leftArrowBtn: {fileID: 1273223491517165518}
  _rightArrowBtn: {fileID: 735847218080713467}
  _cgImage: {fileID: 427820255103989526}
  _captionText: {fileID: 651027898487693081}
  _pageIndicatorText: {fileID: 6735061531919475576}
  _pages:
  - cgImage: {fileID: 21300000, guid: 763add960f56db14d92b77b08b6555a1, type: 3}
    captionText: "\u9019\u662F\u4E00\u500B \u4EE5\u85DD\u8853\u8861\u91CF\u50F9\u503C\u7684\u570B\u5EA6\uFF0C\n\u6B0A\u8CB4\u7528\u5DE8\u5927\u7684\u96D5\u50CF\u5806\u780C\u5A01\u56B4\uFF0C\u7528\u6602\u8CB4\u7684\u756B\u4F5C\u63DB\u53D6\u5730\u4F4D\u3002\n\u5728\u9019\u88E1\u300C\u540D\u8072\u300D\uFF0C\u5373\u662F\u4E00\u5207\u3002\n\n\u8CA7\u56F0\u7684\u756B\u5BB6
      \u2014 \u7E46\u723E\uFF0C\u70BA\u6C42\u751F\u8A08\u4F86\u5230\u9019\u88E1\uFF0C\u5E36\u8457\u4ED6\u7684\u6280\u85DD\u8207\u8D64\u8AA0\u4E4B\u5FC3\u3002"
  - cgImage: {fileID: 21300000, guid: 2e95d0032cef52845a476598ae8864b9, type: 3}
    captionText: "\u5E74\u8F15\u7684\u756B\u5BB6\u4E00\u5915\u6210\u540D\u3002\n\u4ED6\u6C89\u6EBA\u3001\u9189\u5FC3\u65BC\u4EBA\u5011\u7684\u7C07\u64C1\u3001\u7121\u7AAE\u7684\u8CA1\u5BCC\u3001\u96E3\u5F97\u7684\u6B0A\u529B\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u4ED6\u7684\u7B46\u89F8\u4E0D\u518D\u70BA\u4E86\u9748\u9B42\uFF0C\u800C\u662F\u70BA\u4E86\u6572\u958B
      \u300C\u6B0A\u529B\u7684\u5927\u9580\u300D\u3002\n\u751A\u81F3\u4E0D\u60DC\u4EE5\u8EAB\u72AF\u96AA\uFF0C\u7E6A\u88FD\u7981\u756B\u3002"
  - cgImage: {fileID: 21300000, guid: 9eeb9e11fc9ca2d40a7d3b82eecb1a16, type: 3}
    captionText: "\u4ED6\u5992\u7FA8\u8457\u5B78\u5F92\u7684\u624D\u83EF\uFF0C\n\u754F\u61FC\u5F8C\u6D6A\u63A8\u524D\u6D6A\u3002"
  - cgImage: {fileID: 21300000, guid: e5a9a3145ee93e743b33f8e5642b91b9, type: 3}
    captionText: "\u6700\u7D42\u5C07\u4ED6\u4EBA\u7684\u84B4\u679C\u5802\u800C\u7687\u4E4B\u7684\u76DC\u70BA\u5DF1\u7528\u3002"
  - cgImage: {fileID: 21300000, guid: 879f1464665d637429f182fb7c8ae59a, type: 3}
    captionText: "\u617E\u671B\u8207\u8B0A\u8A00\u5806\u780C\u800C\u51FA\u7684\u9AD8\u5854\uFF0C\u9803\u523B\u9593\u3001\u5982\u6D41\u6C99\u822C\u5D29\u584C\u3002\n\u919C\u805E\u50CF\u91CE\u706B\u822C\u71D2\u904D\u4E86\u738B\u57CE\u7684\u8857\u9053\u3002\n\u570B\u738B\u6536\u56DE\u4E86\u8CDE\u8CDC\uFF0C\u8CB4\u65CF\u8F49\u8EAB\u96E2\u53BB\u3002\n\u66FE\u7D93\u7684\u300C\u5929\u624D\u300D\u6210\u4E86\u4EBA\u4EBA\u553E\u68C4\u7684\u7F6A\u4EBA\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u5927\u96E8\u50BE\u7009\uFF0C\u7E46\u723E\u88AB\u9A45\u9010\u4E86\u3002\n\u738B\u570B\u7684\u5927\u9580\u4E00\u5982\u4ED6\u4F86\u5230\u7684\u90A3\u5929\u4E00\u822C\uFF0C\u9AD8\u5927\u3001\u5A01\u56B4\u3001\u838A\u91CD\u4E14\u51B0\u51B7\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u4ED6\u5E36\u8457\u65B7\u6389\u7684\u756B\u7B46\u548C\u7834\u788E\u7684\u81EA\u5C0A\uFF0C\u6D41\u6D6A\u5230\u8352\u6DBC\u7684\u6E56\u7554\u3002\n\u98A8\u5F88\u51B7\uFF0C\u6C34\u5F88\u975C\uFF0C\u9019\u4E16\u754C\u4F3C\u4E4E\u518D\u4E5F\u6C92\u6709\u4EBA\u8A18\u5F97\u4ED6\u7684\u540D\u5B57\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u4ED6\u61CA\u6094\u3001\u4ED6\u6495\u6BC0\u81EA\u5DF1\u7684\u756B\u4F5C\uFF0C\n\u9839\u7136\u7684\u767C\u6D29\u5C0D\u773E\u4EBA\u3001\u5C0D\u738B\u570B\u3001\u5C0D\u4E16\u754C\u7684\u61A4\u6012\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u5931\u53BB\u540D\u8072\u7684\u7E46\u723E\uFF0C\u9664\u4E86\u7F6A\u696D\uFF0C\u4E00\u7121\u6240\u6709\u3002\n\u5DE8\u5927\u7684\u7D55\u671B\u58DF\u7F69\u4ED6\uFF0C\u5C07\u4ED6\u6B7B\u6B7B\u63A9\u57CB\u3002\n\u4ED6\u751A\u81F3\u5FD8\u4E86\u5982\u4F55\u518D\u6B21\u63D0\u7B46\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u9580\u5916\u7684\u5149\u683C\u5916\u523A\u773C\uFF0C\u537B\u53C8\u5438\u5F15\u4EBA\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u5149\u8292\u5F15\u8457\u4ED6\u4F86\u5230\u6E56\u908A\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u300C\u770B\u8457\u6E56\u9762\uFF0C\u7E46\u723E\u3001\u4F60\u770B\u5230\u4E86\u4EC0\u9EBC\uFF1F\u300D\n\u795E\u7955\u7684\u8001\u8005\u81EA\u9727\u4E2D\u51FA\u73FE\uFF0C\u6307\u8457\u5982\u93E1\u9762\u822C\u7684\u6E56\u6CCA\u3002"
  - cgImage: {fileID: 21300000, guid: 31ee516a8b489f84da7a8c1e856928cc, type: 3}
    captionText: "\u4ED6\u770B\u8457\u6C34\u9762\uFF0C\u4ED6\u770B\u898B\u81EA\u5DF1\u7684\u81C9\uFF0C\u626D\u66F2\u6210\u4E00\u96BB\u96BB\u7319\u7370\u7684\u5DE8\u7378\u3002"
  - cgImage: {fileID: 21300000, guid: 8c1d742ebc9dde44ebc28953ce85223b, type: 3}
    captionText: "\u2014 \u552F\u6709\u76F4\u9762\u5167\u5FC3\u6DF1\u8655\u7684\u8CAA\u3001\u55D4\u3001\u7661\uFF0C\u624D\u80FD\u770B\u898B\u771F\u5BE6\u3002"
  - cgImage: {fileID: 21300000, guid: f28ebd035c2bead48a6401b25f762599, type: 3}
    captionText: "\u7E46\u723E\u518D\u6B21\u63E1\u7DCA\u624B\u4E2D\u7684\u756B\u7B46\u3002"
  - cgImage: {fileID: 21300000, guid: edcb84c602b05c742b449b18dcbb1845, type: 3}
    captionText: "\u597D\u4F3C\u56DE\u61C9\u7E46\u723E\u4E00\u822C\uFF0C\u756B\u7B46\u8FF8\u767C\u51FA\u8DB3\u4EE5\u9A45\u6563\u9670\u973E\u7684\u8000\u773C\u5149\u8292\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u9019\u4E00\u6B21\uFF0C\u4ED6\u8981\u627E\u56DE\u5C6C\u65BC\u81EA\u5DF1\u7684\u771F\u5BE6\u3002"
  - cgImage: {fileID: 0}
    captionText: "\u6587\u672C\u5167\u5BB9"
  - cgImage: {fileID: 0}
    captionText: "\u6587\u672C\u5167\u5BB9"
  - cgImage: {fileID: 0}
    captionText: "\u6587\u672C\u5167\u5BB9"
  - cgImage: {fileID: 0}
    captionText: "\u6587\u672C\u5167\u5BB9"
  - cgImage: {fileID: 0}
    captionText: "\u6587\u672C\u5167\u5BB9"
