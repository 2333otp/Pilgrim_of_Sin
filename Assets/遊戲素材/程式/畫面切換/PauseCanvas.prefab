  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PilgrimOfSin.CharacterCodexPageBook
  _leftArrowBtn: {fileID: 227096714943962054}
  _rightArrowBtn: {fileID: 2351545241076370815}
  _artImage: {fileID: 6702387257984689554}
  _nameText: {fileID: 2246422348910840488}
  _descriptionText: {fileID: 7566766533852751979}
  _pageIndicatorText: {fileID: 8352015106576484170}
  _pages:
  - art: {fileID: 21300000, guid: 4d58a8ffe24697647837ebd12872c68d, type: 3}
    charName: "\u7E46\u723E"
    description: "\u6DF1\u9677\u617E\u671B\u56F9\u5704\u7684\u756B\u5BB6\n\u6700\u7D42\u81EA\u98DF\u60E1\u679C\n\u5E61\u7136\u9192\u609F\u5F8C\u8E0F\u4E0A\u514B\u670D\u5984\u5FF5\u7684\u9053\u8DEF"
    artHeight: 1050
    artPosY: 0
  - art: {fileID: 21300000, guid: dd18bfa57b45eb548b6f35b9f8976e14, type: 3}
    charName: "\u840A\u6069"
    description: "\u5E2B\u627F\u7E46\u723E\n\u56E0\u624D\u83EF\u8000\u773C\u53D7\u5E2B\u5085\u5992\u5FCC\n\u6700\u7D42\u767C\u89BA\u7E46\u723E\u7684\u7F6A\u884C\u800C\u5FC3\u7070\u610F\u51B7"
    artHeight: 1050
    artPosY: 120
  - art: {fileID: 21300000, guid: 1afdd7edfe3b7fd4b8a6bd1d93aeb856, type: 3}
    charName: "\u51E1\u65AF"
    description: "\u5728\u6E56\u908A\u73FE\u8EAB\u7684\u795E\u79D8\u8001\u8005\n\u6307\u5F15\u7E46\u723E\u76F4\u9762\u5FC3\u4E2D\u7684\u8CAA\u55D4\u75F4"
    artHeight: 1000
    artPosY: -10
  - art: {fileID: 21300000, guid: 9186622602f222f42a71a1880fc6c420, type: 3}
    charName: "\u5FC3\u9B54-\u8CAA"
    description: "\u81EA\u6975\u81F4\u6C72\u71DF\u7684\u617E\u671B\u4E2D\u964D\u751F\uFF0C\n\u559C\u611B\u8CA1\u5BF6\u8207\u6B0A\u529B\uFF0C\n\u8A98\u4EBA\u5C48\u5F9E\u8CAA\u5FF5\u800C\u58AE\u843D\uFF0C\u6C38\u4E0D\u995C\u8DB3\u3002"
    artHeight: 1000
    artPosY: -10
  - art: {fileID: 21300000, guid: d83623b9d05beab46979d48fae466cc2, type: 3}
    charName: "\u5FC3\u9B54-\u55D4"
    description: "\u56E0\u61A4\u6012\u8207\u5FCC\u5992\u800C\u751F\uFF0C\u559C\u611B\u541E\u566C\u7406\u667A\uFF0C\n\u4E26\u5C07\u5176\u5316\u70BA\u72C2\u66B4\u4E4B\u529B\u6467\u6BC0\u4E00\u5207\u3002\n\u4EE5\u7121\u76E1\u6012\u706B\u9A45\u4F7F\u773E\u751F\uFF0C\u6700\u7D42\u58AE\u5165\u760B\u72C2\u3002"
    artHeight: 1000
    artPosY: -10
  - art: {fileID: 21300000, guid: 72ad9b294ea131f41ac48134a7dae1ba, type: 3}
    charName: "\u5FC3\u9B54-\u7661"
    description: "\u81EA\u57F7\u5FF5\u7684\u6DF1\u6DF5\u800C\u751F\uFF0C\n\u4F7F\u4EBA\u8FF7\u5FC3\uFF0C\u8499\u853D\u601D\u8003\uFF0C\u56F0\u65BC\u56DA\u7C60\uFF0C\n\u4F7F\u773E\u751F\u6210\u70BA\u8FF7\u9014\u7F94\u7F8A\uFF0C\u4EE5\u8FF7\u60D8\u832B\u7136\u70BA\u6A02\u3002"
    artHeight: 1000
    artPosY: -10
