  m_Script: {fileID: 11500000, guid: d1b1ce8a4671e884c8268bf2493158b6, type: 3}
  m_Name: CreditsData
  m_EditorClassIdentifier: Assembly-CSharp::PilgrimOfSin.CreditsData
  _pages:
  - text: "\u904A\u6232\u4E3B\u8981\u88FD\u4F5C\u5718\u968A\uFF1A\u547C\u5695\u547C\u5695\u7280\u5229\n\n\u60C5\u7DD2\u7A69\u5B9A\u7684\u77ED\u5C3E\u77EE\u888B\u9F20aka\u4F01\u5283-\u4F59\u7AF9\u5178\n\u559C\u6B61\u310B\u311F\u310B\u311F\u7684\u516B\u722A\u7AE0\u9B5Aaka\u4F01\u5283-\u65BD\u53C8\u5609\n\u60C5\u7DD2\u4E0D\u7A69\u559C\u6B61\u770B\u7532\u7684\u72D0\u72F8aka\u7F8E\u8853-\u5433\u627F\u598D\n\u60C5\u7DD2\u4E0D\u7A69\u5B9A\u4F46\u975E\u5E38\u611B\u4EBA\u7684\u5409\u5A03\u5A03aka\u7F8E\u8853-\u8D99\u59FF\u96C5\n\u559C\u6B61\u5C0F\u7537\u5B69\u7684\u6241\u6389\u9F20\u9905aka\u6A21\u578B-\u5B6B\u7A4E\u8ED2\n\u559C\u6B61\u8FFD\u5287\u7684\u4EBA\u985Eaka\u6A21\u578B-\u5289\u6C9B\u5A55\n\u6307\u5C0E\u8001\u5E2B-\u8CC0\u8056\u502B"
  - text: "\u904A\u6232\u5167\u914D\u97F3\u8CA0\u8CAC\n\n\u7E46\u723E-\u66FE\u8056\u5091\n\u65C1\u767D-\u5077\u6478\u5927\u96DE\n\u8CAA-\u65BD\u53C8\u5609\n\u55D4-\u9EC3\u7B71\u6674\n\u75F4-\u5433\u627F\u598D"
  - text: "\u7279\u5225\u9298\u8B1D\n\n\u6307\u5C0E\u8001\u5E2B \u8CC0\u8056\u502B
      \u8001\u5E2B\n\u5834\u5916\u63F4\u52A9 \u8607\u79A7\u946B \u8001\u5E2B\n\u97F3\u6A02\u53CA\u8072\u97F3\u76F8\u95DC\u6280\u8853\u6307\u5C0E
      \u8CF4\u5EFA\u5B87 \u8001\u5E2B\n\u5118\u7BA1\u6C92\u5E36\u6211\u5011\u9084\u662F\u8B93\u6211\u5011\u554F\u4E86\u554F\u984C
      \u6E38\u653F\u6A3A \u8001\u5E2B\n\u7D66\u4E86\u6211\u5011\u7C3D\u540D\u7167\u7684
      \u8607\u5F0B\u9E9F \u8001\u5E2B\n\u6211\u5011\u4E0D\u662F\u52D5\u756B\u7D44\u9084\u7D30\u5FC3\u807D\u6211\u5011\u8B1B\u7684
      \u912D\u777F\u54F2 \u8001\u5E2B"
  - text: "\u7279\u5225\u9298\u8B1D\n\n\u914D\u97F3\u652F\u63F4-\u66FE\u8056\u5091
      \u9EC3\u7B71\u6674 \u5077\u6478\u5927\u96DE\n\n\u6700\u5F8C\u6700\u91CD\u8981\u7684-\u6B63\u5728\u904A\u73A9\u7684\u60A8\n\n\u6211\u5011\u7684Instagram\u793E\u7FA4-@pilgrimofsin_112"
